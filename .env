# Environment variables template - add your secrets here
# Groq API keys (comma-separated for rotation)
GROQ_API_KEYS=

# Groq Transcription Configuration
GROQ_TIMEOUT_S=300.0
GROQ_MAX_RPM=18.0
GROQ_JITTER_S=0.25

# Optional: default model to use
GROQ_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b,meta-llama/llama-4-maverick-17b-128e-instruct

# Paths (adjust if needed)
# TRANSCRIPTS_DIR and AUDIO_DIR should be passed as command line arguments

# Which providers to use (comma-separated)
PROVIDERS=github,openrouter,cloudflare,gemini,groq

# --- GITHUB MODELS ---
# GITHUB_MODELS_TOKEN=your_github_token_here
# Correct format for easy script parsing
GITHUB_MODELS=\
openai/gpt-oss-120b
azureml-deepseek/DeepSeek-R1
zhipu-ai/GLM-4.7\

# --- OPENROUTER ---
# OPENROUTER_API_KEYS=your_openrouter_keys_here
# OPENROUTER_MODELS=qwen/qwen-2.5-72b-instruct:free,openai/gpt-oss-120b
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_X_TITLE=TranscriptRenamer

# --- CLOUDFLARE WORKERS AI ---
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
# CLOUDFLARE_MODELS=@cf/openai/gpt-oss-120b,@cf/meta/llama-3.1-70b-instruct

# --- GEMINI ---
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash
